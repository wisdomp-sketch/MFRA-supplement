# Allowlist: ignore everything at the top level, then re-include only the release files.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/prompts/
!/taxonomy/
!/rules/
!/evaluation/
!/splits/
!/results/

# Never commit these, even inside the allowed folders
**/__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
*.key
*.pem
*secret*
*credential*
*token*
*.log
*.jsonl
*.json
*.zip
*.xlsx
.ipynb_checkpoints/
.DS_Store
Thumbs.db
desktop.ini
